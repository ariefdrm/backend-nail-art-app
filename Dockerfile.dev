# Development image: Bun runs TypeScript directly with hot reload.
# Debian (glibc), not Alpine: node_modules is bind-mounted and shared with the host (Ubuntu, glibc),
# so native packages such as @node-rs/argon2 must be built for the same libc on both sides.
FROM docker.io/oven/bun:1.4.3-debian

WORKDIR /app

COPY package*.json bun*.lock ./
RUN bun install --frozen-lockfile

COPY . .

EXPOSE 3000

# Installs dependencies into the bind-mounted node_modules, generates the Prisma client,
# applies migrations, then starts `bun --watch`.
ENTRYPOINT [ "sh", "scripts/dev-entrypoint.sh" ]
