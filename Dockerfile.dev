# Development image: Bun runs TypeScript directly with hot reload.
FROM docker.io/oven/bun:1.4.3-alpine

WORKDIR /app

COPY package*.json bun*.lock ./
RUN bun install --frozen-lockfile

COPY . .

EXPOSE 3000

# Generates the Prisma client, runs `prisma migrate dev`, then starts `bun --watch`.
ENTRYPOINT [ "sh", "scripts/dev-entrypoint.sh" ]
