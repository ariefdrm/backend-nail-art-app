// Data model for The Nail Palace (see PRD section 8 and documents/openapi.yaml).
// Conventions: uuid ids generated by the database, timestamptz columns,
// snake_case tables/columns via @@map/@map.
//
// The anti-overlap EXCLUDE constraint on bookings (and a few CHECK constraints)
// cannot be expressed in this file; they live in the hand-edited migration
// `*_data_model`. Never edit a released migration.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
  no_show

  @@map("booking_status")
}

enum BookingSource {
  online
  admin

  @@map("booking_source")
}

enum AdminRole {
  owner
  staff

  @@map("admin_role")
}

model Admin {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         AdminRole @default(owner)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens RefreshToken[]
  statusChanges BookingStatusHistory[]

  @@map("admins")
}

model RefreshToken {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId   String @map("admin_id") @db.Uuid
  // Only the hash is stored; a used token is revoked on rotation.
  tokenHash String @unique @map("token_hash")

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  userAgent String? @map("user_agent")
  ipAddress String? @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Service {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String  @db.VarChar(120)
  description     String?
  category        String
  // Rupiah, integer.
  price           Int
  // Multiple of 15 (CHECK in migration).
  durationMinutes Int     @map("duration_minutes")
  imageUrl        String? @map("image_url")
  isActive        Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  bookings Booking[]

  @@index([isActive, category])
  @@map("services")
}

model Artist {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String  @db.VarChar(80)
  photoUrl String? @map("photo_url")
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  bookings     Booking[]
  blockedSlots BlockedSlot[]

  @@map("artists")
}

model Booking {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Format NP-YYYYMMDD-XXXX
  bookingCode String        @unique @map("booking_code") @db.VarChar(20)
  status      BookingStatus @default(pending)
  source      BookingSource @default(online)

  serviceId String @map("service_id") @db.Uuid
  artistId  String @map("artist_id") @db.Uuid

  startAt DateTime @map("start_at") @db.Timestamptz(3)
  endAt   DateTime @map("end_at") @db.Timestamptz(3)

  customerName      String  @map("customer_name") @db.VarChar(100)
  // E.164, e.g. +6281234567890
  customerPhone     String  @map("customer_phone") @db.VarChar(20)
  customerNote      String? @map("customer_note") @db.VarChar(500)
  referenceImageUrl String? @map("reference_image_url")

  // Snapshot of the service price at booking time (Rupiah).
  totalPrice   Int       @map("total_price")
  cancelReason String?   @map("cancel_reason") @db.VarChar(255)
  adminNote    String?   @map("admin_note")
  confirmedAt  DateTime? @map("confirmed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  service Service                @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  artist  Artist                 @relation(fields: [artistId], references: [id], onDelete: Restrict)
  history BookingStatusHistory[]

  @@index([artistId, startAt])
  @@index([startAt])
  @@index([status])
  @@index([customerPhone])
  @@map("bookings")
}

model BookingStatusHistory {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId  String         @map("booking_id") @db.Uuid
  // null on creation
  fromStatus BookingStatus? @map("from_status")
  toStatus   BookingStatus  @map("to_status")
  // null = changed by the customer or the system
  changedBy  String?        @map("changed_by") @db.Uuid
  changedAt  DateTime       @default(now()) @map("changed_at") @db.Timestamptz(3)
  reason     String?        @db.VarChar(255)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  admin   Admin?  @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([bookingId, changedAt])
  @@map("booking_status_history")
}

model BusinessHour {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // 0 = Sunday ... 6 = Saturday
  dayOfWeek  Int     @unique @map("day_of_week") @db.SmallInt
  isOpen     Boolean @map("is_open")
  // "HH:mm" in Asia/Jakarta (CHECK in migration)
  openTime   String? @map("open_time") @db.VarChar(5)
  closeTime  String? @map("close_time") @db.VarChar(5)
  // Optional break; slots may not overlap it.
  breakStart String? @map("break_start") @db.VarChar(5)
  breakEnd   String? @map("break_end") @db.VarChar(5)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("business_hours")
}

model BlockedSlot {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // null = the whole studio
  artistId String?  @map("artist_id") @db.Uuid
  startAt  DateTime @map("start_at") @db.Timestamptz(3)
  endAt    DateTime @map("end_at") @db.Timestamptz(3)
  reason   String?  @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  artist Artist? @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([startAt, endAt])
  @@index([artistId])
  @@map("blocked_slots")
}
