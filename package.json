{
  "name": "backend-nail-art-app",
  "author": {
    "name": "ariefdrm",
    "email": "ariefdarmawan5522@gmail.com"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "prisma": "^7.10.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests",
    "test:unit": "bun test tests/unit --coverage --pass-with-no-tests",
    "test:integration": "bun test tests/integration --pass-with-no-tests",
    "prisma:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "bun prisma/seed.ts",
    "verify": "bun run lint && bun run typecheck && bun run test:unit && bun run build"
  }
}
