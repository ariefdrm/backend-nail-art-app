{
  "name": "backend-nail-art-app",
  "author": {
    "name": "ariefdrm",
    "email": "ariefdarmawan5522@gmail.com"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-dist": "^5.34.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-dist": "^3.30.6",
    "@types/web-push": "^3.6.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.0",
    "yaml": "^2.9.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun test tests/unit --coverage --pass-with-no-tests",
    "test:integration": "bun test tests/integration --pass-with-no-tests",
    "prisma:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "bun prisma/seed.ts",
    "db:seed:demo": "bun prisma/seed-demo.ts",
    "db:test:reset": "DATABASE_URL=\"$DATABASE_URL_TEST\" prisma migrate reset --force",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run test:unit && bun run build"
  }
}
