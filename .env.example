# --- Database (compose builds DATABASE_URL from these) ---
POSTGRES_USER="change this with actual user"
POSTGRES_PASSWORD="change this with real password"
POSTGRES_DB="nailpalace_dev"

# Needed on the host for Prisma CLI (prisma.config.ts); compose overrides it inside containers
DATABASE_URL="postgresql://user:password@localhost:5432/nailpalace_dev"

# --- App ---
NODE_ENV=development
PORT=3000
TZ=Asia/Jakarta
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# --- Auth (secrets: random, >= 32 bytes) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# --- Booking rules ---
SLOT_STEP_MINUTES=30
BOOKING_BUFFER_MINUTES=15
MAX_ADVANCE_DAYS=60
CANCEL_MIN_HOURS_BEFORE=0

# --- Seed only ---
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
