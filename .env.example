# --- Database (compose builds DATABASE_URL from these) ---
POSTGRES_USER="change this with actual user"
POSTGRES_PASSWORD="change this with real password"
POSTGRES_DB="nailpalace_dev"

# Needed on the host for Prisma CLI (prisma.config.ts); compose overrides it inside containers
DATABASE_URL="postgresql://user:password@localhost:5432/nailpalace_dev"

# --- App ---
NODE_ENV=development
PORT=3000
TZ=Asia/Jakarta
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
# Reverse proxies in front of the app, so req.ip (and the rate limit) sees the client. Unset = 1 in production, 0 elsewhere.
TRUST_PROXY=

# --- Admin notifications (FR-17): minutes a booking may stay pending before a nudge, and how far ahead a confirmed one is announced ---
NOTIFY_UNCONFIRMED_AFTER_MINUTES=15
NOTIFY_UPCOMING_MINUTES_BEFORE=120

# --- Web Push (FR-17): set all three or none. Keys: bunx web-push generate-vapid-keys. Subject: mailto:you@example.com or an https URL ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Rate limits: requests per IP per window (login 15 min failures only, booking create 1 h, lookup/cancel 15 min, API 1 min) ---
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_BOOKING_MAX=10
RATE_LIMIT_LOOKUP_MAX=30
RATE_LIMIT_GENERAL_MAX=300

# --- API docs at /docs: open outside production; in production served only if DOCS_PASSWORD (>= 12 chars) is set ---
DOCS_USER=docs
DOCS_PASSWORD=

# --- Auth (secrets: random, >= 32 bytes) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# --- Booking rules ---
SLOT_STEP_MINUTES=30
BOOKING_BUFFER_MINUTES=15
MAX_ADVANCE_DAYS=60
CANCEL_MIN_HOURS_BEFORE=0

# --- Seed only (password: at least 12 characters; an existing admin is never overwritten) ---
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
